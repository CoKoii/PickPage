<view class="note-row {{dragging ? 'dragging' : ''}}" bindtouchstart="onTouchStart" capture-bind:touchmove="onTouchMove" catchtouchmove="{{dragAxis === 'horizontal' ? 'noop' : ''}}" bindtouchend="onTouchEnd" bindtouchcancel="onTouchCancel">
  <view class="note-card" style="transform: translate3d({{translateX}}px, 0, 0);">
    <view class="{{note.type === 'voice' ? 'audio-content' : 'note-body'}}">
      <text class="note-content {{note.type === 'voice' ? 'audio-transcript' : ''}}">{{note.excerpt}}</text>
      <view wx:if="{{note.type === 'image'}}" class="note-images">
        <image class="note-image" src="{{note.image}}" mode="aspectFill" />
      </view>
      <view wx:if="{{note.type === 'voice'}}" class="audio-wave-row">
        <view class="audio-wave-box">
          <view class="waveform">
            <view wx:for="{{note.waveform || []}}" wx:key="index" class="wave-bar" style="height: {{item}}rpx;"></view>
          </view>
          <text class="audio-duration">{{note.duration}}</text>
        </view>
      </view>
      <view wx:if="{{note.type === 'voice' && note.translation}}" class="note-translation">
        <text class="translation-label">译文</text>
        <text class="translation-text">{{note.translation}}</text>
      </view>
      <view class="note-meta">
        <text class="tag {{note.tagTone}}">{{note.tag}}</text>
        <text wx:if="{{note.isPinned}}" class="pinned-label">置顶</text>
        <text class="meta-source">{{note.source}}</text>
        <text class="meta-time">{{note.time}}</text>
      </view>
    </view>
  </view>

  <view class="note-action-rail" style="width: {{railWidth}}px;">
    <view class="action-slot pin-slot">
      <view class="action-item pin-action" style="opacity: {{actionOpacity}};" bindtap="onPinTap" aria-role="button" aria-label="{{note.isPinned ? '取消置顶' : '置顶'}}">
        <view class="action-circle"><image class="action-icon" src="/assets/png-icons/pin-white.png" mode="aspectFit" /></view>
        <text class="action-label">{{note.isPinned ? '取消置顶' : '置顶'}}</text>
      </view>
    </view>
    <view class="action-slot delete-slot">
      <view class="action-item delete-action" style="opacity: {{actionOpacity}};" bindtap="onDeleteTap" aria-role="button" aria-label="删除">
        <view class="delete-background"><view class="delete-background-fill"></view></view>
        <view class="delete-content {{armed ? 'armed' : ''}}">
          <view class="action-circle"><image class="action-icon" src="/assets/png-icons/trash-2.png" mode="aspectFit" /></view>
          <text class="action-label delete-label">删除</text>
        </view>
      </view>
    </view>
  </view>
</view>
