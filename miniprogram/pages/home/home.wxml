<view class="home-shell">
  <view class="home-fixed">
    <home-header class="home-section" top-inset="{{headerTopInset}}" />
    <view class="quick-grid">
      <button wx:for="{{quickActions}}" wx:key="id" class="quick-item" data-title="{{item.title}}" bindtap="onQuickAction">
        <view class="quick-icon"><icon name="{{item.icon}}" size="37" /></view>
        <text class="quick-label quick-label-{{item.tone}}">{{item.title}}</text>
      </button>
    </view>
    <section-toolbar class="home-section" title="{{listTitle}}" bind:filter="onFilter" bind:sort="onSort" />
  </view>
  <scroll-view class="home-scroll" scroll-y enhanced show-scrollbar="false" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" refresher-background="#f5f6f7" bindrefresherrefresh="onPullDownRefresh">
    <view class="note-scroll-content">
      <view class="note-list">
        <note-card wx:for="{{notes}}" wx:key="id" note="{{item}}" reveal-level="{{openNoteId === item.id ? openLevel : 0}}" bind:action="onNoteAction" />
      </view>
      <view class="scroll-end-space"></view>
    </view>
  </scroll-view>
</view>
